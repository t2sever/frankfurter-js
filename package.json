{
  "name": "frankfurter-js",
  "version": "0.1.1",
  "description": "A lightweight TypeScript SDK for the Frankfurter currency API.",
  "author": "tinsever",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/t2sever/frankfurter-js"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm,cjs --dts",
    "dev": "tsdown src/index.ts --format esm,cjs --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "frankfurter",
    "currency",
    "exchange-rates",
    "forex",
    "sdk",
    "typescript"
  ],
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsdown": "^0.21.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
